#!/usr/bin/python3
"""Launcher that works from a source checkout (bin/../wxgtk) or an install (launcher next to wxgtk/)."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for root in (here, os.path.join(here, "..")):
    if os.path.isdir(os.path.join(root, "wxgtk")):
        sys.path.insert(0, root)
        break
from wxgtk.app import main  # noqa: E402

sys.exit(main())
